# Copy to .env and fill in.

# Where the authenticated browser session (from `mutsniper login`) is stored.
MUTSNIPER_SESSION_PATH=session.json

# SQLite database file for auction/price history.
MUTSNIPER_DB_PATH=mutsniper.db

# Comma-separated player names/ids to watch. "ALL" is not supported -
# the auction house is searched per player, so pick the cards you care about.
MUTSNIPER_WATCHLIST=

# How often to re-poll the watchlist, in seconds.
MUTSNIPER_POLL_INTERVAL_SECONDS=45

# Flag a listing as a snipe when it's priced this fraction below the
# rolling median sold price (0.30 = 30% below market).
MUTSNIPER_SNIPE_THRESHOLD_PCT=0.30

# Don't trust a card's market price until we've observed at least this
# many sales for it.
MUTSNIPER_MIN_SAMPLES=3

# How far back to look when computing the rolling median sold price.
MUTSNIPER_LOOKBACK_HOURS=72

# Optional: Discord webhook URL for snipe alerts.
MUTSNIPER_DISCORD_WEBHOOK_URL=
