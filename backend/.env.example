# Postgres (matches docker-compose.yml defaults)
MUTSNIPER_DATABASE_URL=postgresql+asyncpg://mutsniper:mutsniper@localhost:5432/mutsniper

# EAClient selection: "mock" (default, safe to run with no EA access at all)
# or "real". Keep this on "mock" until RealEAClient._parse_response is wired
# up against a real sample response.
MUTSNIPER_EA_CLIENT=mock

# Only used when MUTSNIPER_EA_CLIENT=real.
MUTSNIPER_EA_ENDPOINT_URL=
MUTSNIPER_EA_HTTP_METHOD=GET
MUTSNIPER_EA_TOKEN=
# JSON object of extra headers, e.g. {"X-UT-SID": "..."}
MUTSNIPER_EA_HEADERS_JSON={}
# Request template. Use $min_ovr / $max_ovr / $program / $position
# placeholders (string.Template syntax, not str.format - so literal JSON
# braces in the template don't need escaping). Example for a query-param
# style search: {"minOvr": "$min_ovr", "program": "$program"}
MUTSNIPER_EA_REQUEST_TEMPLATE_JSON={}

# Watchlist: JSON list of filter sets to poll each cycle. Each entry is
# {min_ovr, max_ovr, program, position} - all keys optional.
MUTSNIPER_WATCHLIST_JSON=[{"min_ovr": 90}]

# Poll pacing
MUTSNIPER_POLL_INTERVAL_MIN_SECONDS=4
MUTSNIPER_POLL_INTERVAL_MAX_SECONDS=8
MUTSNIPER_POLL_RATE_CAP_PER_MINUTE=20

# Price model
MUTSNIPER_PRICE_WINDOW_HOURS=6
MUTSNIPER_PRICE_MIN_SAMPLES=8
MUTSNIPER_AH_TAX_RATE=0.10
MUTSNIPER_SNIPE_MARGIN_THRESHOLD=0.25

# Optional Discord alerts
MUTSNIPER_DISCORD_ALERTS_ENABLED=false
MUTSNIPER_DISCORD_WEBHOOK_URL=
